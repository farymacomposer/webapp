<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Faryma.Composer.Desktop.Navigation.MessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ContentDialogSmokeFill}">
        <Grid
            MinWidth="320"
            MaxWidth="1000"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource GridOverlayDialogStyle}"
            Translation="0 0 64">
            <Grid.Shadow>
                <ThemeShadow />
            </Grid.Shadow>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                Padding="24"
                Background="{ThemeResource ContentDialogTopOverlay}"
                BorderBrush="{ThemeResource ContentDialogSeparatorBorderBrush}"
                BorderThickness="0,0,0,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock x:Name="Title" Style="{StaticResource SubtitleTextBlockStyle}" />

                <ScrollView Grid.Row="1">
                    <StackPanel Padding="0,24,0,0" Spacing="16">

                        <TextBlock
                            x:Name="Message"
                            FontSize="16"
                            TextWrapping="WrapWholeWords" />

                        <TextBlock x:Name="SubMessage" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </ScrollView>
            </Grid>

            <Grid
                Grid.Row="1"
                Padding="24"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="FirstButton"
                    HorizontalAlignment="Stretch"
                    Click="FirstButton_Click" />

                <Button
                    x:Name="SecondButton"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Click="SecondButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
