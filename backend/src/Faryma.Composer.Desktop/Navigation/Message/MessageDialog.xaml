<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Faryma.Composer.Desktop.Navigation.Message.MessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Faryma.Composer.Desktop.Navigation.Message"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    TabNavigation="Cycle"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ContentDialogSmokeFill}">
        <Grid
            MinWidth="320"
            MaxWidth="1000"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource ContentDialogBackground}"
            BorderBrush="{ThemeResource ContentDialogBorderBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            Translation="0 0 64">
            <Grid.Shadow>
                <ThemeShadow />
            </Grid.Shadow>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Padding="24"
                Background="{ThemeResource ContentDialogTopOverlay}"
                BorderBrush="{ThemeResource ContentDialogSeparatorBorderBrush}"
                BorderThickness="0,0,0,1">
                <TextBlock x:Name="Title" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    x:Name="Message"
                    Margin="0,12"
                    TextWrapping="WrapWholeWords" />
                <TextBlock x:Name="SubMessage" TextWrapping="WrapWholeWords" />
            </StackPanel>

            <Grid Grid.Row="1" Padding="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="FirstButton"
                    HorizontalAlignment="Stretch"
                    Click="FirstButton_Click" />

                <Button
                    x:Name="SecondButton"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    Click="SecondButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
