<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Faryma.Composer.Desktop.Navigation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Faryma.Composer.Desktop.Navigation"
    Title="Faryma.Composer.Desktop">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TitleBar
                x:Name="titleBar"
                IsPaneToggleButtonVisible="True"
                PaneToggleRequested="TitleBar_PaneToggleRequested" />

            <NavigationView
                x:Name="navView"
                Grid.Row="1"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                Loaded="NavigationViewLoaded"
                MenuItemsSource="{x:Bind ViewModel.Pages}"
                SelectionChanged="NavigationViewSelectionChanged">
                <NavigationView.MenuItemTemplate>
                    <DataTemplate x:DataType="local:PageVM">
                        <NavigationViewItem Content="{x:Bind Title}">
                            <NavigationViewItem.Icon>
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="{x:Bind Icon}" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </DataTemplate>
                </NavigationView.MenuItemTemplate>

                <Frame x:Name="PageFrame" />

            </NavigationView>
        </Grid>

        <ContentControl
            x:Name="DialogFrame"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />

        <Border Background="{ThemeResource ContentDialogSmokeFill}" Visibility="{x:Bind ViewModel.ProgressVisibility, Mode=OneWay}">
            <ProgressRing
                Width="100"
                Height="100"
                IsActive="{x:Bind ViewModel.ProgressIsActive, Mode=OneWay}" />
        </Border>

        <ContentControl
            x:Name="MessageFrame"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch" />
    </Grid>
</Window>