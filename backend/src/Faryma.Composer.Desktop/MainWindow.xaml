<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Faryma.Composer.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Faryma.Composer.Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Faryma.Composer.Desktop.ViewModels"
    Title="Faryma.Composer.Desktop"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        Loaded="NavigationViewLoaded"
        MenuItemsSource="{x:Bind Pages}"
        PaneDisplayMode="Top"
        SelectionChanged="NavigationViewSelectionChanged">
        <NavigationView.MenuItemTemplate>
            <DataTemplate x:DataType="vm:PageViewModel">
                <NavigationViewItem Content="{x:Bind Title}">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="{x:Bind Icon}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </DataTemplate>
        </NavigationView.MenuItemTemplate>

        <Frame x:Name="PageFrame" />
    </NavigationView>
</Window>
