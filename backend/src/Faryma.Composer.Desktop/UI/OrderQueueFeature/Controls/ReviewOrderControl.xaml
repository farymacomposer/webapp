<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Faryma.Composer.Desktop.UI.OrderQueueFeature.ReviewOrderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Faryma.Composer.Desktop.UI.OrderQueueFeature"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sharedVM="using:Faryma.Composer.Desktop.Shared.ViewModels"
    d:DataContext="{d:DesignInstance Type=sharedVM:ReviewOrderVM}"
    mc:Ignorable="d">

    <Grid
        Background="#E4FFFFFF"
        BorderBrush="{ThemeResource SystemControlForegroundChromeMediumBrush}"
        BorderThickness="0,1,0,0">
        <Grid Margin="6,4">
            <StackPanel>
                <TextBlock FontSize="16" Text="{Binding Title}" />
                <TextBlock FontSize="16" Text="{Binding Id}" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="4">

                <StackPanel>
                    <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding InProgressAt}" />
                    <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding CompletedAt}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding Type}" />
                    <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding CategoryType}" />
                    <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding Status}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="{StaticResource NeutralBrush}" Text="IsFrozen: " />
                        <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding IsFrozen}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="{StaticResource NeutralBrush}" Text="QueueIndex: " />
                        <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding QueueIndex}" />
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding ActivityStatus}" />
                    <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding CurrentCategoryType}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="{StaticResource NeutralBrush}" Text="DebtNumber: " />
                        <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding CategoryDebtNumber}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel>
                    <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding StreamEventDate}" />
                    <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding StreamStatus}" />
                    <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding StreamType}" />
                    <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding StreamWentLiveAt}" />
                    <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding StreamCompletedAt}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel
            x:Name="Buttons"
            Margin="4"
            VerticalAlignment="Bottom"
            Orientation="Horizontal"
            Spacing="8">

            <Button
                AccessKey="&#xE74A;"
                Style="{StaticResource EditButtonStyle}"
                ToolTipService.ToolTip="Апнуть" />

            <Button
                AccessKey="&#xE71B;"
                Style="{StaticResource EditButtonStyle}"
                ToolTipService.ToolTip="Ссылка на трек" />

            <Button
                AccessKey="&#xE768;"
                Style="{StaticResource EditButtonStyle}"
                ToolTipService.ToolTip="Взять в работу" />

            <Button
                AccessKey="&#xE930;"
                Style="{StaticResource EditButtonStyle}"
                ToolTipService.ToolTip="Выполнить" />

            <Button
                AccessKey="&#xE74F;"
                Style="{StaticResource EditButtonStyle}"
                ToolTipService.ToolTip="Заморозить" />

            <Button
                AccessKey="&#xE767;"
                Style="{StaticResource EditButtonStyle}"
                ToolTipService.ToolTip="Разморозить" />

            <Button
                AccessKey="&#xE711;"
                Style="{StaticResource EditButtonStyle}"
                ToolTipService.ToolTip="Отменить" />
        </StackPanel>


        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PointerStates">
                <VisualState x:Name="Exited">
                    <Storyboard>
                        <FadeOutThemeAnimation Storyboard.TargetName="Buttons" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Entered">
                    <Storyboard>
                        <FadeInThemeAnimation Storyboard.TargetName="Buttons" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
