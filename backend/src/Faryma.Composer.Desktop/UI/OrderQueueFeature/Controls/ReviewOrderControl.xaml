<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Faryma.Composer.Desktop.UI.OrderQueueFeature.ReviewOrderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Faryma.Composer.Desktop.UI.OrderQueueFeature"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sharedVM="using:Faryma.Composer.Desktop.Shared.ViewModels"
    d:DataContext="{d:DesignInstance Type=sharedVM:ReviewOrderVM}"
    mc:Ignorable="d">

    <Grid
        Background="Transparent"
        BorderBrush="{ThemeResource SystemControlForegroundChromeMediumBrush}"
        BorderThickness="0,1,0,0">
        <Grid>
            <StackPanel>

                <TextBlock
                    Margin="16,12"
                    FontSize="16"
                    Text="{Binding Title, Mode=OneTime}" />

                <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding TrackUrl, Mode=OneWay}" />
            </StackPanel>

            <StackPanel
                Margin="24,12"
                HorizontalAlignment="Right"
                Orientation="Horizontal">

                <StackPanel>
                    <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding InProgressAt, Mode=OneTime}" />
                    <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding CompletedAt, Mode=OneTime}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding Type, Mode=OneTime}" />
                    <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding CategoryType, Mode=OneTime}" />
                    <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding Status, Mode=OneTime}" />
                </StackPanel>

                <TextBlock Foreground="{StaticResource NeutralBrush}" Text="{Binding IsFrozen, Mode=OneTime}" />
            </StackPanel>
        </Grid>

        <Button
            x:Name="EditButton"
            Margin="16,12"
            VerticalAlignment="Top"
            Style="{StaticResource EditButtonStyle}">
            <Button.Flyout>
                <Flyout>
                    <local:ReviewOrderCommandsControl />
                </Flyout>
            </Button.Flyout>
        </Button>


        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PointerStates">
                <VisualState x:Name="Exited">
                    <Storyboard>
                        <FadeOutThemeAnimation Storyboard.TargetName="EditButton" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Entered">
                    <Storyboard>
                        <FadeInThemeAnimation Storyboard.TargetName="EditButton" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
