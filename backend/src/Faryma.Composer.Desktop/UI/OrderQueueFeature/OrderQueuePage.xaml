<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Faryma.Composer.Desktop.UI.OrderQueueFeature.OrderQueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Faryma.Composer.Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Faryma.Composer.Desktop.UI.OrderQueueFeature"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sharedVM="using:Faryma.Composer.Desktop.Shared.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <StackPanel
                Padding="16"
                Orientation="Horizontal"
                Spacing="16">

                <StackPanel Spacing="8">

                    <StackPanel
                        Width="516"
                        Padding="8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="White"
                        CornerRadius="4"
                        Spacing="8">

                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="24">
                            <Button Command="{x:Bind ViewModel.GenerateOrderCommand}">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.CreateReviewOrderCommand}" Content="Создать новый заказ" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <controls:TitledContentRow
                                Title="IdempotencyKey"
                                Content="{x:Bind ViewModel.IdempotencyKey, Mode=OneWay}"
                                FontFamily="Consolas" />
                            <Button Command="{x:Bind ViewModel.GenerateIdempotencyKeyCommand}">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" />
                            </Button>
                        </StackPanel>

                        <controls:TitledContentRow Title="Nickname">
                            <TextBox Text="{x:Bind ViewModel.Nickname, Mode=TwoWay}" />
                        </controls:TitledContentRow>

                        <controls:TitledContentRow Title="OrderType">
                            <ComboBox ItemsSource="{x:Bind ViewModel.OrderTypes, Mode=OneTime}" SelectedItem="{x:Bind ViewModel.OrderType, Mode=TwoWay}" />
                        </controls:TitledContentRow>

                        <controls:TitledContentRow Title="TrackUrl" Content="{x:Bind ViewModel.TrackUrl, Mode=OneWay}" />
                        <controls:TitledContentRow Title="PaymentAmount" Content="{x:Bind ViewModel.PaymentAmount, Mode=OneWay}" />
                        <controls:TitledContentRow Title="UserComment" Content="{x:Bind ViewModel.UserComment, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8">

                    <controls:TitledContentRow Title="Id выбранного заказа" Content="{x:Bind ViewModel.SelectedOrder.Id, Mode=OneWay, FallbackValue={x:Null}}" />

                    <StackPanel
                        Padding="8"
                        Background="White"
                        CornerRadius="4"
                        Spacing="8">

                        <Button
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.UpReviewOrderCommand}"
                            Content="Апнуть" />

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <controls:TitledContentRow
                                Title="IdempotencyKey"
                                Content="{x:Bind ViewModel.IdempotencyKey, Mode=OneWay}"
                                FontFamily="Consolas" />
                            <Button Command="{x:Bind ViewModel.GenerateIdempotencyKeyCommand}">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" />
                            </Button>
                        </StackPanel>

                        <controls:TitledContentRow Title="Nickname">
                            <TextBox Text="{x:Bind ViewModel.Nickname, Mode=TwoWay}" />
                        </controls:TitledContentRow>

                        <controls:TitledContentRow Title="PaymentAmount" Content="{x:Bind ViewModel.PaymentAmount, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel
                        Padding="8"
                        Background="White"
                        CornerRadius="4"
                        Spacing="8">

                        <Button
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.AddTrackUrlCommand}"
                            Content="Добавить ссылку на трек" />

                        <controls:TitledContentRow Title="TrackUrl" Content="{x:Bind ViewModel.TrackUrl, Mode=OneWay}" />
                    </StackPanel>

                    <Button Command="{x:Bind ViewModel.TakeOrderInProgressCommand}" Content="Взять в работу" />
                    <Button Command="{x:Bind ViewModel.CompleteReviewOrderCommand}" Content="Выполнить" />
                    <Button Command="{x:Bind ViewModel.FreezeReviewOrderCommand}" Content="Заморозить" />
                    <Button Command="{x:Bind ViewModel.UnfreezeReviewOrderCommand}" Content="Разморозить" />
                    <Button Command="{x:Bind ViewModel.CancelReviewOrderCommand}" Content="Отменить" />
                </StackPanel>
            </StackPanel>

            <local:ReviewOrderControl
                Grid.Column="1"
                VerticalAlignment="Center"
                DataContext="{x:Bind ViewModel.OrderQueueService.InProgressOrder, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid Background="#64C4FF">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock HorizontalAlignment="Center" Text="FrozenOrders" />

                <ListView
                    Grid.Row="1"
                    ItemContainerStyle="{StaticResource DisableListViewItemContainerStyle}"
                    ItemsSource="{x:Bind ViewModel.OrderQueueService.FrozenOrders}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="sharedVM:ReviewOrderVM">
                            <local:ReviewOrderControl />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="1" Background="Silver">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock HorizontalAlignment="Center" Text="ScheduledOrders" />

                <ListView
                    Grid.Row="1"
                    ItemContainerStyle="{StaticResource DisableListViewItemContainerStyle}"
                    ItemsSource="{x:Bind ViewModel.OrderQueueService.ScheduledOrders}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="sharedVM:ReviewOrderVM">
                            <local:ReviewOrderControl />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="2" Background="#75FF7B">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock HorizontalAlignment="Center" Text="ActiveOrders" />

                <ListView
                    Grid.Row="1"
                    ItemContainerStyle="{StaticResource DisableListViewItemContainerStyle}"
                    ItemsSource="{x:Bind ViewModel.OrderQueueService.ActiveOrders}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="sharedVM:ReviewOrderVM">
                            <local:ReviewOrderControl />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="3" Background="#FDFF90">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock HorizontalAlignment="Center" Text="CompletedOrders" />

                <ListView
                    Grid.Row="1"
                    ItemContainerStyle="{StaticResource DisableListViewItemContainerStyle}"
                    ItemsSource="{x:Bind ViewModel.OrderQueueService.CompletedOrders}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="sharedVM:ReviewOrderVM">
                            <local:ReviewOrderControl />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
