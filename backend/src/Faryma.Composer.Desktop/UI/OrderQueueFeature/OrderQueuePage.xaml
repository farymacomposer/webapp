<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Faryma.Composer.Desktop.UI.OrderQueueFeature.OrderQueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Faryma.Composer.Desktop.UI.OrderQueueFeature"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sharedVM="using:Faryma.Composer.Desktop.Shared.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <local:ReviewOrderControl DataContext="{x:Bind ViewModel.OrderQueueService.InProgressOrder, Mode=OneWay}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid Background="#FDFF90">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock HorizontalAlignment="Center" Text="CompletedOrders" />

                <ListView
                    Grid.Row="1"
                    ItemContainerStyle="{StaticResource DisableListViewItemContainerStyle}"
                    ItemsSource="{x:Bind ViewModel.OrderQueueService.CompletedOrders}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="sharedVM:ReviewOrderVM">
                            <local:ReviewOrderControl />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="1" Background="#75FF7B">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock HorizontalAlignment="Center" Text="ActiveOrders" />

                <ListView
                    Grid.Row="1"
                    ItemContainerStyle="{StaticResource DisableListViewItemContainerStyle}"
                    ItemsSource="{x:Bind ViewModel.OrderQueueService.ActiveOrders}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="sharedVM:ReviewOrderVM">
                            <local:ReviewOrderControl />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="2" Background="Silver">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock HorizontalAlignment="Center" Text="ScheduledOrders" />

                <ListView
                    Grid.Row="1"
                    ItemContainerStyle="{StaticResource DisableListViewItemContainerStyle}"
                    ItemsSource="{x:Bind ViewModel.OrderQueueService.ScheduledOrders}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="sharedVM:ReviewOrderVM">
                            <local:ReviewOrderControl />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="3" Background="#64C4FF">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock HorizontalAlignment="Center" Text="FrozenOrders" />

                <ListView
                    Grid.Row="1"
                    ItemContainerStyle="{StaticResource DisableListViewItemContainerStyle}"
                    ItemsSource="{x:Bind ViewModel.OrderQueueService.FrozenOrders}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="sharedVM:ReviewOrderVM">
                            <local:ReviewOrderControl />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
