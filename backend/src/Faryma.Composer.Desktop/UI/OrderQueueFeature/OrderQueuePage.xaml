<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Faryma.Composer.Desktop.UI.OrderQueueFeature.OrderQueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Faryma.Composer.Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Faryma.Composer.Desktop.UI.OrderQueueFeature"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sharedVM="using:Faryma.Composer.Desktop.Shared.ViewModels"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Padding="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="16">

                <StackPanel Spacing="8">

                    <StackPanel Style="{StaticResource StackPanelCardStyle}">

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <controls:TitledContentRow
                                Title="IdempotencyKey"
                                Content="{x:Bind ViewModel.IdempotencyKey, Mode=OneWay}"
                                FontFamily="Consolas" />
                            <Button Command="{x:Bind ViewModel.GenerateIdempotencyKeyCommand}">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" />
                            </Button>
                        </StackPanel>

                        <controls:TitledContentRow Title="Nickname">
                            <TextBox Text="{x:Bind ViewModel.Nickname, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </controls:TitledContentRow>

                        <controls:TitledContentRow Title="PaymentAmount">
                            <TextBox
                                ui:TextBoxExtensions.ValidationMode="Dynamic"
                                ui:TextBoxExtensions.ValidationType="Number"
                                Text="{x:Bind ViewModel.PaymentAmount, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </controls:TitledContentRow>

                        <controls:TitledContentRow Title="OrderType">
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.OrderTypes, Mode=OneTime}"
                                SelectedItem="{x:Bind ViewModel.OrderType, Mode=TwoWay}" />
                        </controls:TitledContentRow>

                        <controls:TitledContentRow Title="TrackUrl" Content="{x:Bind ViewModel.TrackUrl, Mode=OneWay}" />

                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="24">
                            <Button Command="{x:Bind ViewModel.ClearOrderCommand}">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE894;" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.GenerateOrderCommand}">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" />
                            </Button>
                            <Button
                                Command="{x:Bind ViewModel.CreateReviewOrderCommand}"
                                Content="Создать новый заказ"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <controls:TitledContentRow
                        Title="SyncVersion"
                        Content="{x:Bind ViewModel.OrderQueueService.SyncVersion, Mode=OneWay}"
                        FontSize="16" />

                    <Button
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.UpdateOrderQueueCommand}"
                        Content="Обновить очередь"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <StackPanel Spacing="8">

                    <StackPanel Style="{StaticResource StackPanelCardStyle}">

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <controls:TitledContentRow
                                Title="IdempotencyKey"
                                Content="{x:Bind ViewModel.IdempotencyKey, Mode=OneWay}"
                                FontFamily="Consolas" />
                            <Button Command="{x:Bind ViewModel.GenerateIdempotencyKeyCommand}">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" />
                            </Button>
                        </StackPanel>

                        <controls:TitledContentRow Title="Nickname">
                            <TextBox Text="{x:Bind ViewModel.Nickname, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </controls:TitledContentRow>

                        <controls:TitledContentRow Title="PaymentAmount">
                            <TextBox
                                ui:TextBoxExtensions.ValidationMode="Dynamic"
                                ui:TextBoxExtensions.ValidationType="Number"
                                Text="{x:Bind ViewModel.PaymentAmount, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </controls:TitledContentRow>

                        <Button
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.MoveUpReviewOrderCommand}"
                            Content="Поднять в очереди"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource StackPanelCardStyle}">

                        <controls:TitledContentRow Title="TrackUrl" Content="{x:Bind ViewModel.TrackUrl, Mode=OneWay}" />

                        <Button
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.AddTrackUrlCommand}"
                            Content="Добавить ссылку на трек"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>

                    <controls:TitledContentRow
                        Title="Id выбранного заказа"
                        Content="{x:Bind ViewModel.SelectedOrder.Id, Mode=OneWay, FallbackValue={x:Null}}"
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

                    <Button
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.FreezeReviewOrderCommand}"
                        Content="Заморозить"
                        Style="{StaticResource AccentButtonStyle}" />

                    <Button
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.CancelReviewOrderCommand}"
                        Content="Отменить"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <ListView
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        ItemContainerStyle="{StaticResource DisableListViewItemContainerStyle}"
                        ItemsSource="{x:Bind ViewModel.StreamSchedule}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="sharedVM:StreamContainerVM">
                                <Grid
                                    Margin="0,2"
                                    Padding="6,4"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Height="30"
                                            MinWidth="32"
                                            Command="{x:Bind SelectCommand}"
                                            Content="{x:Bind Stream.Id, Mode=OneWay, FallbackValue={x:Null}}"
                                            Style="{StaticResource AccentButtonStyle}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Text="{x:Bind Date, Mode=OneWay}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <TextBlock Text="{x:Bind Stream.Status, Mode=OneWay, FallbackValue={x:Null}}" />
                                            <TextBlock Text="{x:Bind Stream.Type, Mode=OneWay, FallbackValue={x:Null}}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Stream.StartedAt, Mode=OneWay, FallbackValue={x:Null}}" />
                                            <TextBlock Text="{x:Bind Stream.CompletedAt, Mode=OneWay, FallbackValue={x:Null}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Column="2" Spacing="8">

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.CurrentWeekCommand}" Content="Сегодня" />
                            <Button Command="{x:Bind ViewModel.PreviousWeekCommand}">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE76B;" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.NextWeekCommand}">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE76C;" />
                            </Button>
                            <TextBlock />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Style="{StaticResource StackPanelCardStyle}">

                            <controls:TitledContentRow Title="EventDate" Content="{x:Bind ViewModel.SelectedEventDate, Mode=OneWay}" />

                            <controls:TitledContentRow Title="StreamType">
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.StreamTypes, Mode=OneTime}"
                                    SelectedItem="{x:Bind ViewModel.StreamType, Mode=TwoWay}" />
                            </controls:TitledContentRow>

                            <Button
                                HorizontalAlignment="Center"
                                Command="{x:Bind ViewModel.CreateStreamCommand}"
                                Content="Создать новый стрим"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Spacing="8">

                        <controls:TitledContentRow
                            Title="Id выбранного стрима"
                            Content="{x:Bind ViewModel.SelectedStream.Id, Mode=OneWay, FallbackValue={x:Null}}"
                            FontSize="16"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource RightContentAlignment}" />

                        <Button
                            Command="{x:Bind ViewModel.StartStreamCommand}"
                            Content="Начать стрим"
                            Style="{StaticResource AccentButtonStyle}" />

                        <Button
                            Command="{x:Bind ViewModel.CompleteStreamCommand}"
                            Content="Завершить стрим"
                            Style="{StaticResource AccentButtonStyle}" />

                        <Button
                            Command="{x:Bind ViewModel.CancelStreamCommand}"
                            Content="Отменить стрим"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <StackPanel Style="{StaticResource StackPanelCardStyle}">

                        <controls:TitledContentRow Title="Rating">
                            <TextBox
                                ui:TextBoxExtensions.ValidationMode="Dynamic"
                                ui:TextBoxExtensions.ValidationType="Number"
                                Text="{x:Bind ViewModel.Rating, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        </controls:TitledContentRow>

                        <Button
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.CompleteReviewOrderCommand}"
                            Content="Выполнить"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>

                    <Border
                        Grid.Column="2"
                        Height="100"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <local:ReviewOrderControl DataContext="{x:Bind ViewModel.OrderQueueService.InProgressOrder, Mode=OneWay}" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="8" />
                <ColumnDefinition />
                <ColumnDefinition Width="8" />
                <ColumnDefinition />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>

            <Grid Style="{StaticResource GridCardStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="16">
                    <Button
                        Command="{x:Bind ViewModel.UnfreezeReviewOrderCommand}"
                        Content="Разморозить"
                        Style="{StaticResource AccentButtonStyle}" />
                    <TextBlock VerticalAlignment="Center" Text="FrozenOrders" />
                </StackPanel>
                <ListView
                    Grid.Row="1"
                    ItemContainerStyle="{StaticResource DisableListViewItemContainerStyle}"
                    ItemsSource="{x:Bind ViewModel.OrderQueueService.FrozenOrders}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="sharedVM:ReviewOrderVM">
                            <local:ReviewOrderControl />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="2" Style="{StaticResource GridCardStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="ScheduledOrders" />
                <ListView
                    Grid.Row="1"
                    ItemContainerStyle="{StaticResource DisableListViewItemContainerStyle}"
                    ItemsSource="{x:Bind ViewModel.OrderQueueService.ScheduledOrders}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="sharedVM:ReviewOrderVM">
                            <local:ReviewOrderControl />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="4" Style="{StaticResource GridCardStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="16">
                    <Button
                        Command="{x:Bind ViewModel.TakeOrderInProgressCommand}"
                        Content="Взять в работу"
                        Style="{StaticResource AccentButtonStyle}" />
                    <TextBlock VerticalAlignment="Center" Text="ActiveOrders" />
                </StackPanel>
                <ListView
                    Grid.Row="1"
                    ItemContainerStyle="{StaticResource DisableListViewItemContainerStyle}"
                    ItemsSource="{x:Bind ViewModel.OrderQueueService.ActiveOrders}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="sharedVM:ReviewOrderVM">
                            <local:ReviewOrderControl />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Grid Grid.Column="6" Style="{StaticResource GridCardStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="CompletedOrders" />
                <ListView
                    Grid.Row="1"
                    ItemContainerStyle="{StaticResource DisableListViewItemContainerStyle}"
                    ItemsSource="{x:Bind ViewModel.OrderQueueService.CompletedOrders}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="sharedVM:ReviewOrderVM">
                            <local:ReviewOrderControl />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
