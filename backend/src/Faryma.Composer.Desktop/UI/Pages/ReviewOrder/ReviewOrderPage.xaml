<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Faryma.Composer.Desktop.UI.ReviewOrderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Faryma.Composer.Desktop.UI"
    xmlns:vm="using:Faryma.Composer.Desktop.ViewModels"
    xmlns:wuxdata="using:Microsoft.UI.Xaml.Data">
    <Page.Resources>

        <CollectionViewSource
            x:Name="ActivityGroups"
            IsSourceGrouped="True"
            ItemsPath="Items"
            Source="{x:Bind ViewModel.ActivityGroups}" />

        <DataTemplate x:Key="ZoomedInTemplate" x:DataType="vm:ReviewOrderVM">
            <Grid
                Padding="6,4,12,4"
                BorderBrush="{ThemeResource SystemControlForegroundChromeMediumBrush}"
                BorderThickness="0,1,0,0">

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Height="30"
                            MinWidth="32"
                            Command="{Binding SelectCommand}"
                            Content="{Binding Id}"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Border
                            Padding="6,0"
                            Background="{Binding MainNickname, Converter={StaticResource StringHashHighlightConverter}}"
                            CornerRadius="4">
                            <TextBox
                                VerticalAlignment="Center"
                                FontSize="16"
                                IsReadOnly="True"
                                RequestedTheme="Light"
                                Text="{Binding MainNickname}" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{Binding TotalAmount}" />
                    <TextBlock FontSize="16" Text="{Binding CreatedAt}" />
                    <TextBlock Text="{Binding TrackUrl}" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding InProgressAt}" />
                        <TextBlock Text="{Binding CompletedAt}" />
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Type}" />
                        <TextBlock Text="{Binding CategoryType}" />
                        <TextBlock Text="{Binding Status}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="IsFrozen:" />
                            <TextBlock Text="{Binding IsFrozen}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Padding="6,4"
                        Background="{Binding CurrentCategoryType, Converter={StaticResource OrderCategoryHighlightConverter}}"
                        CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="QueueIndex:" />
                            <TextBlock Text="{Binding QueueIndex}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ActivityStatus}" />
                        <TextBlock Text="{Binding CurrentCategoryType}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="DebtIndex:" />
                            <TextBlock Text="{Binding CategoryDebtIndex}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="StreamId:" />
                            <TextBlock Text="{Binding StreamId}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StreamEventDate}" />
                        <TextBlock Text="{Binding StreamStatus}" />
                        <TextBlock Text="{Binding StreamType}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ZoomedInGroupHeaderTemplate" x:DataType="vm:ReviewOrderGroup">
            <TextBlock
                Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind Title}" />
        </DataTemplate>

        <DataTemplate x:Key="ZoomedOutTemplate" x:DataType="wuxdata:ICollectionViewGroup">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ((vm:ReviewOrderGroup)Group).Title}" />
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel
            Padding="6,4"
            Orientation="Horizontal"
            Spacing="4">
            <Button Command="{x:Bind ViewModel.OpenCreateReviewOrderCommand}" Content="Создать заказ" />
            <Button Content="Найти заказ" />
        </StackPanel>

        <SemanticZoom x:Name="Control1" Grid.Row="1">
            <SemanticZoom.ZoomedInView>
                <ListView
                    GotFocus="List_GotFocus"
                    ItemTemplate="{StaticResource ZoomedInTemplate}"
                    ItemsSource="{x:Bind ActivityGroups.View}"
                    ScrollViewer.IsHorizontalScrollChainingEnabled="False"
                    SelectionMode="None">
                    <ListView.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource ZoomedInGroupHeaderTemplate}" />
                    </ListView.GroupStyle>
                </ListView>
            </SemanticZoom.ZoomedInView>
            <SemanticZoom.ZoomedOutView>
                <ListView
                    GotFocus="List_GotFocus"
                    ItemTemplate="{StaticResource ZoomedOutTemplate}"
                    ItemsSource="{x:Bind ActivityGroups.View.CollectionGroups}"
                    SelectionMode="None" />
            </SemanticZoom.ZoomedOutView>
        </SemanticZoom>
    </Grid>
</Page>