<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Faryma.Composer.Desktop.UI.ReviewOrderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Faryma.Composer.Desktop.UI"
    xmlns:vm="using:Faryma.Composer.Desktop.ViewModels"
    xmlns:wuxdata="using:Microsoft.UI.Xaml.Data">
    <Page.Resources>

        <CollectionViewSource
            x:Name="ActivityGroups"
            IsSourceGrouped="True"
            ItemsPath="Orders"
            Source="{x:Bind ViewModel.ActivityGroups}" />

        <DataTemplate x:Key="ZoomedInTemplate" x:DataType="vm:ReviewOrderVM">
            <Button
                Margin="0,2"
                HorizontalAlignment="Stretch"
                Style="{StaticResource ButtonFlatStyle}">
                <Grid Style="{StaticResource GridCardStyle}">

                    <StackPanel HorizontalAlignment="Left" Spacing="8">

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Grid Width="200">
                                <Border
                                    Background="{x:Bind MainNickname, Converter={StaticResource StringHashHighlightConverter}}"
                                    CornerRadius="4"
                                    Opacity="0.2" />
                                <TextBox IsReadOnly="True" Text="{x:Bind MainNickname}" />
                            </Grid>
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind TotalAmount}" />
                        </StackPanel>

                        <TextBlock Text="{x:Bind TrackUrl}" />
                    </StackPanel>

                    <TextBlock HorizontalAlignment="Right" Text="{x:Bind CreatedAt}" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ZoomedInGroupHeaderTemplate" x:DataType="vm:ReviewOrderGroup">
            <TextBlock
                Foreground="{ThemeResource ApplicationForegroundThemeBrush}"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind Title}" />
        </DataTemplate>

        <DataTemplate x:Key="ZoomedOutTemplate" x:DataType="wuxdata:ICollectionViewGroup">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ((vm:ReviewOrderGroup)Group).Title}" />
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="20,27,36,36" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <SemanticZoom x:Name="Control1" Width="1000">
            <SemanticZoom.ZoomedInView>
                <ListView
                    GotFocus="List_GotFocus"
                    ItemTemplate="{StaticResource ZoomedInTemplate}"
                    ItemsSource="{x:Bind ActivityGroups.View}"
                    ScrollViewer.IsHorizontalScrollChainingEnabled="False"
                    SelectionMode="None">
                    <ListView.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource ZoomedInGroupHeaderTemplate}" />
                    </ListView.GroupStyle>
                </ListView>
            </SemanticZoom.ZoomedInView>
            <SemanticZoom.ZoomedOutView>
                <ListView
                    GotFocus="List_GotFocus"
                    ItemTemplate="{StaticResource ZoomedOutTemplate}"
                    ItemsSource="{x:Bind ActivityGroups.View.CollectionGroups}"
                    SelectionMode="None" />
            </SemanticZoom.ZoomedOutView>
        </SemanticZoom>

        <StackPanel
            Grid.Column="1"
            Width="400"
            Margin="0,40,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource StackPanelCardStyle}">

            <Button
                Width="150"
                HorizontalAlignment="Right"
                Command="{x:Bind ViewModel.OpenCreateReviewOrderCommand}"
                Content="Создать заказ"
                Style="{StaticResource AccentButtonStyle}" />

            <Button
                Width="150"
                HorizontalAlignment="Right"
                Content="Найти заказ"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>