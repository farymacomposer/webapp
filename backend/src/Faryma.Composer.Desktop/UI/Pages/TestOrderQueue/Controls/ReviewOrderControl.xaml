<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Faryma.Composer.Desktop.UI.ReviewOrderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Faryma.Composer.Desktop.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ReviewOrderVM}"
    mc:Ignorable="d">

    <Grid
        Padding="6,4,12,4"
        BorderBrush="{ThemeResource SystemControlForegroundChromeMediumBrush}"
        BorderThickness="0,1,0,0">

        <StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Height="30"
                    MinWidth="32"
                    Command="{Binding SelectCommand}"
                    Content="{Binding Id}"
                    Style="{StaticResource AccentButtonStyle}" />
                <Border
                    Padding="6,0"
                    Background="{Binding MainNickname, Converter={StaticResource StringHashHighlightConverter}}"
                    CornerRadius="4">
                    <TextBox
                        VerticalAlignment="Center"
                        FontSize="16"
                        IsReadOnly="True"
                        RequestedTheme="Light"
                        Text="{Binding MainNickname}" />
                </Border>
            </StackPanel>
            <TextBlock
                FontSize="16"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{Binding TotalAmount}" />
            <TextBlock FontSize="16" Text="{Binding CreatedAt}" />
            <TextBlock Text="{Binding TrackUrl}" />
        </StackPanel>

        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding InProgressAt}" />
                <TextBlock Text="{Binding CompletedAt}" />
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Type}" />
                <TextBlock Text="{Binding Status}" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="IsFrozen:" />
                    <TextBlock Text="{Binding IsFrozen}" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                Padding="6,4"
                Background="{Binding CurrentQueueCategory, Converter={StaticResource QueueCategoryHighlightConverter}}"
                CornerRadius="4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="QueueIndex:" />
                    <TextBlock Text="{Binding QueueIndex}" />
                </StackPanel>
                <TextBlock Text="{Binding ActivityStatus}" />
                <TextBlock Text="{Binding CurrentQueueCategory}" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="DebtIndex:" />
                    <TextBlock Text="{Binding CategoryDebtIndex}" />
                </StackPanel>
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="StreamId:" />
                    <TextBlock Text="{Binding StreamId}" />
                </StackPanel>
                <TextBlock Text="{Binding StreamEventDate}" />
                <TextBlock Text="{Binding StreamStatus}" />
                <TextBlock Text="{Binding StreamType}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
