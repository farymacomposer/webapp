<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Faryma.Composer.Desktop.UI.ComposerStreamPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:local="using:Faryma.Composer.Desktop.UI"
    xmlns:test="using:Microsoft.UI.Xaml">

    <Grid Width="1000" Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.CurrentMonth.ToString('MMMM yyyy', x:Null), Mode=OneWay}" />

        <Grid Grid.Row="1" Margin="0,36,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <TextBlock HorizontalAlignment="Center" Text="Пн" />
            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Center"
                Text="Вт" />
            <TextBlock
                Grid.Column="2"
                HorizontalAlignment="Center"
                Text="Ср" />
            <TextBlock
                Grid.Column="3"
                HorizontalAlignment="Center"
                Text="Чт" />
            <TextBlock
                Grid.Column="4"
                HorizontalAlignment="Center"
                Text="Пт" />
            <TextBlock
                Grid.Column="5"
                HorizontalAlignment="Center"
                Text="Сб" />
            <TextBlock
                Grid.Column="6"
                HorizontalAlignment="Center"
                Text="Вс" />
        </Grid>

        <ItemsRepeater
            Grid.Row="2"
            Margin="0,12,0,24"
            ItemsSource="{x:Bind ViewModel.Days}">
            <ItemsRepeater.Layout>
                <UniformGridLayout
                    ItemsStretch="Fill"
                    MaximumRowsOrColumns="7"
                    Orientation="Horizontal" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="local:StreamDaySlotVM">
                    <Button
                        HorizontalAlignment="Stretch"
                        Opacity="{x:Bind IsCurrentMonth, Converter={StaticResource BoolToOpacityConverter}}"
                        Style="{StaticResource FlatButton}">
                        <Grid Padding="0" Style="{StaticResource GridCardStyle}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Margin="16,14,16,8" Text="{x:Bind Date.Day}" />

                            <StackPanel
                                Grid.Row="1"
                                Padding="16"
                                Background="{x:Bind Stream.Status, Converter={StaticResource ComposerStreamStatusHighlightConverter}, FallbackValue={x:Null}}"
                                CornerRadius="0 0 4 4"
                                Spacing="16">

                                <TextBlock Text="{x:Bind Stream.Type, Converter={StaticResource EnumDescriptionConverter}, FallbackValue={x:Null}}" />

                                <TextBlock Text="{x:Bind Stream.Status, Converter={StaticResource EnumDescriptionConverter}, FallbackValue={x:Null}}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">

            <Button
                Command="{x:Bind ViewModel.PrevMonthCommand}"
                Content="&#xE72B;"
                FontFamily="Segoe MDL2 Assets" />

            <Button Command="{x:Bind ViewModel.GoToCurrentMonthCommand}" Content="Текущий месяц" />

            <Button
                Command="{x:Bind ViewModel.NextMonthCommand}"
                Content="&#xE72A;"
                FontFamily="Segoe MDL2 Assets" />
        </StackPanel>
    </Grid>
</Page>