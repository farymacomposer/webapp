<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Faryma.Composer.Desktop.UI.ComposerStreamPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Faryma.Composer.Desktop.UI"
    xmlns:test="using:Microsoft.UI.Xaml"
    xmlns:vm="using:Faryma.Composer.Desktop.ViewModels">
    <Page.Resources>
        <local:BindingProxy x:Key="BindingProxy" ViewModel="{x:Bind ViewModel}" />
    </Page.Resources>

    <Grid Margin="36">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid Width="1000" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.CurrentMonth.ToString('MMMM yyyy', x:Null), Mode=OneWay}" />

            <Grid Grid.Row="1" Margin="0,36,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <TextBlock HorizontalAlignment="Center" Text="Пн" />
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    Text="Вт" />
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    Text="Ср" />
                <TextBlock
                    Grid.Column="3"
                    HorizontalAlignment="Center"
                    Text="Чт" />
                <TextBlock
                    Grid.Column="4"
                    HorizontalAlignment="Center"
                    Text="Пт" />
                <TextBlock
                    Grid.Column="5"
                    HorizontalAlignment="Center"
                    Text="Сб" />
                <TextBlock
                    Grid.Column="6"
                    HorizontalAlignment="Center"
                    Text="Вс" />
            </Grid>

            <ItemsRepeater
                Grid.Row="2"
                Height="742"
                Margin="0,12,0,0"
                ItemsSource="{x:Bind ViewModel.Days}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MaximumRowsOrColumns="7"
                        MinItemHeight="124"
                        Orientation="Horizontal" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:ComposerStreamDaySlotVM">
                        <Button
                            Margin="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Command="{Binding ViewModel.SelectDaySlotCommand, Source={StaticResource BindingProxy}, Mode=OneTime}"
                            CommandParameter="{x:Bind}"
                            Style="{StaticResource FlatButton}">
                            <Grid>

                                <Grid
                                    Padding="0"
                                    Opacity="{x:Bind IsCurrentMonth, Converter={StaticResource BoolToOpacityConverter}}"
                                    Style="{StaticResource GridCardStyle}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>

                                    <Border
                                        Width="24"
                                        Margin="14,12,0,8"
                                        HorizontalAlignment="Left">
                                        <TextBlock HorizontalAlignment="Center" Text="{x:Bind Date.Day}" />
                                    </Border>

                                    <Border
                                        x:Name="DayArea"
                                        Width="24"
                                        Margin="14,12,0,8"
                                        HorizontalAlignment="Left"
                                        x:Load="{x:Bind IsToday}"
                                        Background="{ThemeResource SystemFillColorSuccessBrush}"
                                        CornerRadius="4">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Text="{x:Bind Date.Day}" />
                                    </Border>

                                    <Grid
                                        x:Name="StreamArea"
                                        Grid.Row="1"
                                        x:Load="{x:Bind HasStream, Mode=OneWay}">

                                        <Border
                                            Background="{x:Bind Stream.Status, Mode=OneWay, Converter={StaticResource ComposerStreamStatusHighlightConverter}}"
                                            CornerRadius="0 0 4 4"
                                            Opacity="0.2" />

                                        <StackPanel Padding="16,16,16,0" Spacing="16">
                                            <TextBlock Text="{x:Bind Stream.Type, Mode=OneWay, Converter={StaticResource EnumDescriptionConverter}}" />
                                            <TextBlock Text="{x:Bind Stream.Status, Mode=OneWay, Converter={StaticResource EnumDescriptionConverter}}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <Border
                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                    BorderThickness="2"
                                    CornerRadius="4"
                                    Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <StackPanel
                Grid.Row="3"
                Margin="0,24,6,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">

                <Button Command="{x:Bind ViewModel.PrevMonthCommand}">
                    <SymbolIcon Symbol="Back" />
                </Button>

                <Button
                    VerticalAlignment="Stretch"
                    Command="{x:Bind ViewModel.GoToCurrentMonthCommand}"
                    Content="Текущий месяц" />

                <Button Command="{x:Bind ViewModel.NextMonthCommand}">
                    <SymbolIcon Symbol="Forward" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel
            Grid.Column="2"
            Width="400"
            Margin="0,91,0,0"
            HorizontalAlignment="Left"
            Spacing="16">

            <StackPanel Style="{StaticResource StackPanelCardStyle}">

                <local:TitledContentRow Title="Выбранная дата">
                    <TextBlock Text="{x:Bind ViewModel.SelectedDate, Mode=OneWay}" />
                </local:TitledContentRow>

                <ComboBox
                    HorizontalAlignment="Stretch"
                    Header="Тип стрима"
                    ItemsSource="{x:Bind ViewModel.StreamTypes}"
                    SelectedItem="{x:Bind ViewModel.SelectedStreamType, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button
                    Width="150"
                    HorizontalAlignment="Right"
                    Command="{x:Bind ViewModel.CreateStreamCommand}"
                    Content="Создать стрим"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <StackPanel Style="{StaticResource StackPanelCardStyle}">

                <local:TitledContentRow Title="Тип стрима">
                    <TextBlock Text="{x:Bind ViewModel.SelectedStream.Type, Mode=OneWay, Converter={StaticResource EnumDescriptionConverter}, FallbackValue={x:Null}}" />
                </local:TitledContentRow>

                <Grid>
                    <Border
                        Background="{x:Bind ViewModel.SelectedStream.Status, Mode=OneWay, Converter={StaticResource ComposerStreamStatusHighlightConverter}, FallbackValue={x:Null}}"
                        CornerRadius="4"
                        Opacity="0.2" />
                    <local:TitledContentRow Title="Статус стрима">
                        <TextBlock Text="{x:Bind ViewModel.SelectedStream.Status, Mode=OneWay, Converter={StaticResource EnumDescriptionConverter}, FallbackValue={x:Null}}" />
                    </local:TitledContentRow>
                </Grid>

                <local:TitledContentRow Title="Начало стрима">
                    <TextBlock Text="{x:Bind ViewModel.SelectedStream.StartedAt, Mode=OneWay, FallbackValue={x:Null}}" />
                </local:TitledContentRow>

                <local:TitledContentRow Title="Завершение стрима">
                    <TextBlock Text="{x:Bind ViewModel.SelectedStream.CompletedAt, Mode=OneWay, FallbackValue={x:Null}}" />
                </local:TitledContentRow>

                <Button
                    Width="150"
                    HorizontalAlignment="Right"
                    Command="{x:Bind ViewModel.StartStreamCommand}"
                    Content="Начать стрим"
                    Style="{StaticResource AccentButtonStyle}" />

                <Button
                    Width="150"
                    HorizontalAlignment="Right"
                    Command="{x:Bind ViewModel.CompleteStreamCommand}"
                    Content="Завершить стрим"
                    Style="{StaticResource AccentButtonStyle}" />

                <Button
                    Width="150"
                    HorizontalAlignment="Right"
                    Command="{x:Bind ViewModel.CancelStreamCommand}"
                    Content="Отменить стрим"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>