<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Faryma.Composer.Desktop.UI.ComposerStreamPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Faryma.Composer.Desktop.UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel
            Margin="0,16"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">

            <Button
                Command="{x:Bind ViewModel.PrevMonthCommand}"
                Content="&#xE72B;"
                FontFamily="Segoe MDL2 Assets" />

            <TextBlock
                VerticalAlignment="Center"
                FontSize="20"
                Text="{x:Bind ViewModel.CurrentMonth, Mode=OneWay}" />

            <Button
                Command="{x:Bind ViewModel.NextMonthCommand}"
                Content="&#xE72A;"
                FontFamily="Segoe MDL2 Assets" />
        </StackPanel>

        <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind ViewModel.Days}">
            <ItemsRepeater.Layout>
                <UniformGridLayout
                    ItemsStretch="Fill"
                    MaximumRowsOrColumns="7"
                    Orientation="Horizontal" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="local:DaySlot">
                    <Grid Style="{StaticResource GridCardStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{x:Bind Date.Day}" />
                    </Grid>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
    </Grid>
</Page>