<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Faryma.Composer.Desktop.UI.ComposerStreamDaySlotEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Faryma.Composer.Desktop.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:navigation="using:Faryma.Composer.Desktop.Navigation"
    mc:Ignorable="d">

    <navigation:CustomContentDialog Title="{x:Bind ViewModel.Date, Mode=OneWay}" CloseButtonCommand="{x:Bind ViewModel.HideDialogCommand}">
        <navigation:CustomContentDialog.DialogContent>
            <Grid Padding="16">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="16" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <StackPanel Style="{StaticResource StackPanelCardStyle}">
                    <local:TitledContentRow Title="Тип стрима" IsEnabled="{x:Bind ViewModel.NoStream, Mode=OneWay}">
                        <ComboBox ItemsSource="{x:Bind ViewModel.StreamTypes}" SelectedItem="{x:Bind ViewModel.StreamType, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </local:TitledContentRow>
                </StackPanel>

                <Button
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.CreateStreamCommand}"
                    Content="Создать стрим" />

                <!--<StackPanel Grid.Row="2" Style="{StaticResource StackPanelCardStyle}">

                    <local:TitledContentRow Title="Тип стрима">
                        <TextBlock Text="{x:Bind ViewModel.Stream.Type, Mode=OneWay, Converter={StaticResource EnumDescriptionConverter}, FallbackValue={x:Null}}" />
                    </local:TitledContentRow>

                    <local:TitledContentRow Title="Статус стрима" Background="{x:Bind ViewModel.Stream.Status, Mode=OneWay, Converter={StaticResource ComposerStreamStatusHighlightConverter}, TargetNullValue={ThemeResource SubtleFillColorSecondaryBrush}, FallbackValue={x:Null}}">
                        <TextBlock Text="{x:Bind ViewModel.Stream.Status, Mode=OneWay, Converter={StaticResource EnumDescriptionConverter}, FallbackValue={x:Null}}" />
                    </local:TitledContentRow>

                    <local:TitledContentRow Title="Начало стрима">
                        <TextBlock Text="{x:Bind ViewModel.Stream.StartedAt, Mode=OneWay, Converter={StaticResource EnumDescriptionConverter}, FallbackValue={x:Null}}" />
                    </local:TitledContentRow>

                    <local:TitledContentRow Title="Завершение стрима">
                        <TextBlock Text="{x:Bind ViewModel.Stream.CompletedAt, Mode=OneWay, Converter={StaticResource EnumDescriptionConverter}, FallbackValue={x:Null}}" />
                    </local:TitledContentRow>
                </StackPanel>-->

                <StackPanel
                    Grid.Row="2"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Spacing="16">

                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.StartStreamCommand}"
                        Content="Начать стрим" />

                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.CompleteStreamCommand}"
                        Content="Завершить стрим" />

                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.CancelStreamCommand}"
                        Content="Отменить стрим" />
                </StackPanel>
            </Grid>
        </navigation:CustomContentDialog.DialogContent>
    </navigation:CustomContentDialog>
</UserControl>
