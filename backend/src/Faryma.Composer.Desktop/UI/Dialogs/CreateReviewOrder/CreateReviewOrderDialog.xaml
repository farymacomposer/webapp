<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Faryma.Composer.Desktop.UI.CreateReviewOrderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:commonDialog="using:Faryma.Composer.Desktop.Navigation"
    xmlns:local="using:Faryma.Composer.Desktop.UI">

    <commonDialog:CustomContentDialog Title="TestDialog" CloseButtonCommand="{x:Bind ViewModel.HideDialogCommand}">
        <commonDialog:CustomContentDialog.DialogContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Text="{x:Bind ViewModel.MyProperty, Mode=OneWay}" />

            </Grid>
        </commonDialog:CustomContentDialog.DialogContent>
    </commonDialog:CustomContentDialog>
</UserControl>
