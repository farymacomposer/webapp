<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Faryma.Composer.Desktop.UI.Dialogs.TestDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:commonDialog="using:Faryma.Composer.Desktop.Navigation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Faryma.Composer.Desktop.UI.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <commonDialog:CustomContentDialog Title="TestDialog" CloseButtonCommand="{x:Bind ViewModel.HideDialogCommand}">
        <commonDialog:CustomContentDialog.DialogContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Text="{x:Bind ViewModel.MyProperty, Mode=OneWay}" />

            </Grid>
        </commonDialog:CustomContentDialog.DialogContent>
    </commonDialog:CustomContentDialog>
</UserControl>
