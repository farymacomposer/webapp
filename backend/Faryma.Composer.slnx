<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="x64" />
    <Platform Name="x86" />
  </Configurations>
  <Folder Name="/deploy/">
    <File Path="../.env" />
    <File Path="../.github/workflows/backend.yml" />
    <File Path="../backend.Dockerfile" />
    <File Path="../docker-compose.yml" />
    <File Path="entrypoint.sh" />
  </Folder>
  <Folder Name="/src/" />
  <Folder Name="/src/01 EntryPoints/">
    <Project Path="src/Faryma.Composer.Api/Faryma.Composer.Api.csproj" />
    <Project Path="src/Faryma.Composer.Desktop/Faryma.Composer.Desktop.csproj">
      <Platform Solution="*|Any CPU" Project="x64" />
      <Deploy Solution="*|Any CPU" />
    </Project>
    <Project Path="src/Faryma.Composer.MigrationsBundle/Faryma.Composer.MigrationsBundle.csproj" />
  </Folder>
  <Folder Name="/src/02 Core/">
    <Project Path="src/Faryma.Composer.Application/Faryma.Composer.Application.csproj" />
    <Project Path="src/Faryma.Composer.Domain/Faryma.Composer.Domain.csproj" />
  </Folder>
  <Folder Name="/src/03 Infrastructure/">
    <Project Path="src/Faryma.Composer.Infrastructure/Faryma.Composer.Infrastructure.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Faryma.Composer.Api.Test/Faryma.Composer.Api.Test.csproj" />
    <Project Path="tests/Faryma.Composer.Application.Test/Faryma.Composer.Application.Test.csproj" />
    <Project Path="tests/Faryma.Composer.Testing/Faryma.Composer.Testing.csproj" />
  </Folder>
</Solution>
